<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane alignment="CENTER" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dk.easv.tiffixexamweblager.GUI.Controllers.ChooseScanSettingsController">

    <VBox maxHeight="668.0" maxWidth="420" prefHeight="668.0" prefWidth="420" spacing="0" styleClass="card">

        <HBox alignment="CENTER_LEFT" spacing="8" styleClass="modal-header">
            <Label styleClass="title" text="Select Box &amp; Profile" />
            <Region HBox.hgrow="ALWAYS" />
            <padding>
                <Insets bottom="16" left="16" right="16" top="16" />
            </padding>
        </HBox>

        <Separator />

        <VBox spacing="8">
            <padding>
                <Insets bottom="12.0" left="20.0" right="20.0" top="5.0" />
            </padding>
            <Label styleClass="modal-subtitle" text="1. Choose the box to work on:" />
         <HBox alignment="CENTER" prefHeight="11.0" prefWidth="340.0">
            <children>
               <ToggleButton fx:id="toggleCreate" maxWidth="1.7976931348623157E308" mnemonicParsing="false" selected="true" styleClass="right-pill" text="Create Box" HBox.hgrow="ALWAYS">
                  <toggleGroup>
                     <ToggleGroup fx:id="selectCreateToggle" />
                  </toggleGroup>
               </ToggleButton>
               <ToggleButton fx:id="toggleSelect" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="left-pill" text="Select Box" toggleGroup="$selectCreateToggle" HBox.hgrow="ALWAYS" />
            </children>
         </HBox>
         <VBox fx:id="vboxSelectToggle">
            <children>
                  <ComboBox fx:id="boxComboBox" editable="true" maxWidth="Infinity" promptText="Select a box" styleClass="combo-box-base" />
            </children>
         </VBox>
         <VBox fx:id="vboxCreateToggle" spacing="8.0">
            <children>
               <TextField fx:id="txtfieldTitle" promptText="Title" />
               <TextField fx:id="txtfieldNumber" promptText="Number" />
               <ComboBox fx:id="customerCombobox" maxWidth="1.7976931348623157E308" promptText="Select customer" />
            </children>
         </VBox>
        </VBox>

        <Separator />

        <VBox prefHeight="419.0" prefWidth="380.0" spacing="12" VBox.vgrow="ALWAYS">
            <padding>
                <Insets bottom="12.0" left="20.0" right="20.0" top="5.0" />
            </padding>
            <Label styleClass="modal-subtitle" text="2. Choose your profile:" wrapText="true" />
            <TextField fx:id="txtfieldSearchbar" promptText="Search profiles" styleClass="text-field" />
            <ScrollPane fitToWidth="true" prefHeight="300.0" prefWidth="340.0" styleClass="profile-scroll">
                <content>
                    <VBox fx:id="profileList" spacing="8" styleClass="profile-list">
                        <padding>
                            <Insets bottom="4" left="4" right="4" top="4" />
                        </padding>
                    </VBox>
                </content>
            </ScrollPane>
        </VBox>

        <Separator />

        <HBox alignment="CENTER_RIGHT" prefHeight="30.0" prefWidth="380.0" spacing="10">
            <padding>
                <Insets bottom="14" left="20" right="20" top="14" />
            </padding>

            <Button mnemonicParsing="false" onAction="#onBtnClose" styleClass="action-btn" text="Cancel" />
            <Button fx:id="btnStartSession" defaultButton="true" mnemonicParsing="false" onAction="#onBtnStartSession" styleClass="action-btn" text="Start Session" />
        </HBox>

    </VBox>
</StackPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="root"
      alignment="CENTER"
      spacing="4"
      styleClass="file-tile"
      stylesheets="@/css/style.css"
      xmlns="http://javafx.com/javafx/24.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="dk.easv.tiffixexamweblager.GUI.Controllers.components.ScannedFileTileController">

    <ImageView fx:id="imgThumbnail"
               fitHeight="160.0"
               fitWidth="120.0"
               pickOnBounds="true"
               preserveRatio="false"/>

    <Label fx:id="lblFileTitle"
           alignment="CENTER"
           maxWidth="Infinity"
           text="File"
           wrapText="true"
           styleClass="text-muted"/>

</VBox>




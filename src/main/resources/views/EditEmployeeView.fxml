<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane alignment="CENTER" prefHeight="282.0" prefWidth="294.0" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dk.easv.tiffixexamweblager.GUI.Controllers.EditEmployeeController">

    <VBox
            alignment="TOP_CENTER"
            prefWidth="420"
            maxWidth="420"
            prefHeight="360"
            maxHeight="360"
            spacing="10"
            styleClass="card">


    <padding>
            <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
        </padding>

        <Label styleClass="title" text="Edit Employee" />

        <VBox spacing="6.0">
            <VBox.margin><Insets top="8.0" /></VBox.margin>

            <TextField fx:id="txtFirstName" maxWidth="Infinity" prefHeight="33" promptText="First Name" styleClass="text-field" />
            <Label fx:id="lblFirstNameError" managed="false" maxWidth="Infinity" prefHeight="14.0" styleClass="error-label" visible="false" />

            <TextField fx:id="txtLastName" maxWidth="Infinity" prefHeight="33" promptText="Last Name" styleClass="text-field" />
            <Label fx:id="lblLastNameError" managed="false" maxWidth="Infinity" prefHeight="14.0" styleClass="error-label" visible="false" />

            <TextField fx:id="txtUserName" maxWidth="Infinity" prefHeight="33" promptText="Username" styleClass="text-field" />
            <Label fx:id="lblUsernameError" managed="false" maxWidth="Infinity" prefHeight="14.0" styleClass="error-label" visible="false" />

            <TextField fx:id="txtPassword" maxWidth="Infinity" prefHeight="33" promptText="Leave blank to keep current password" styleClass="text-field" />
            <Label fx:id="lblPasswordError" managed="false" maxWidth="Infinity" prefHeight="14.0" styleClass="error-label" visible="false" />
        </VBox>

        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <VBox.margin><Insets top="12.0" /></VBox.margin>

            <Button fx:id="btnCancel" mnemonicParsing="false" onAction="#onBtnCancel" prefHeight="33" prefWidth="90" styleClass="button, neutral" text="Cancel" />

            <Button fx:id="btnSave" mnemonicParsing="false" onAction="#onBtnSave" prefHeight="33" prefWidth="90" styleClass="action-btn" text="Save" />
        </HBox>

    </VBox>
</StackPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import atlantafx.base.controls.ModalPane?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane fx:id="root" prefHeight="600.0" prefWidth="900.0" stylesheets="@/css/style.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dk.easv.tiffixexamweblager.GUI.Controllers.EmployeeDashboardController">

    <BorderPane fx:id="dashboardContent" prefHeight="448.0" prefWidth="550.0" styleClass="dashboard">

        <top>
         <VBox BorderPane.alignment="CENTER">
            <children>
                <HBox prefHeight="26.0" prefWidth="687.0">
                    <children>
                        <ImageView fitHeight="37.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../img/Tiffix.png" />
                            </image>
                        </ImageView>
                        <Region HBox.hgrow="ALWAYS" />
                        <fx:include source="../components/ThemeToggleButton.fxml" />
                    </children>
                    <padding>
                        <Insets top="4.0" right="8.0" />
                    </padding>
                </HBox>
                  <HBox fx:id="topToolBar" alignment="CENTER_LEFT" prefHeight="48.0" spacing="8.0" styleClass="dashboard-toolbar">

                      <Button fx:id="btnLogout" onAction="#onLogout" styleClass="action-btn">
                          <graphic>
                        <FontIcon iconLiteral="bi-box-arrow-right" />
                     </graphic>
                      </Button>

                      <Button fx:id="StartScanningSession" mnemonicParsing="false" onAction="#onBtnStartScanningSession" styleClass="action-btn" text="Start scanning session" />

                      <Button fx:id="btnFetch" mnemonicParsing="false" onAction="#onBtnFetch" styleClass="action-btn" text="Fetch" />

                      <Region HBox.hgrow="ALWAYS" />

                      <HBox alignment="CENTER" prefHeight="48.0" spacing="6">
                          <Label minWidth="-Infinity" styleClass="h3" text="Box" />
                          <Label fx:id="lblBoxID" minWidth="-Infinity" styleClass="h3" text="" />
                          <Label minWidth="-Infinity" styleClass="h3" text="|" />
                          <Label fx:id="lblDocumentNr" minWidth="-Infinity" styleClass="h3" text="" />
                      </HBox>

                      <Region HBox.hgrow="ALWAYS" />

                      <HBox alignment="CENTER" prefHeight="48.0" spacing="6">
                          <Label minWidth="-Infinity" styleClass="h3" text="Files in box" />
                          <Label fx:id="lblTotalFilesInBox" minWidth="-Infinity" styleClass="h3" />
                      </HBox>

                      <padding>
                     <Insets left="8.0" right="8.0" />
                  </padding>
                  </HBox>
            </children>
         </VBox>
        </top>

        <center>
            <SplitPane dividerPositions="0.45" BorderPane.alignment="CENTER">
                <items>

                    <VBox fx:id="documentsPanel" styleClass="documents-panel" VBox.vgrow="ALWAYS">

                        <HBox alignment="CENTER_LEFT" spacing="5.0">
                            <Label fx:id="lblTotalDocText" styleClass="text-muted" text="Total documents in the box:" />
                            <Label fx:id="lblTotalDocInBox" styleClass="h3" text="0" />
                        </HBox>

                        <ScrollPane fx:id="documentsScrollPane" fitToWidth="true" styleClass="transparent-scroll" VBox.vgrow="ALWAYS">
                            <content>
                                <TilePane fx:id="documentsTilePane" hgap="14.0" prefColumns="3" vgap="14.0">
                                    <padding>
                                        <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
                                    </padding>
                                </TilePane>
                            </content>
                        </ScrollPane>

                        <Button mnemonicParsing="false" onAction="#onBtnExport" styleClass="action-btn" text="Export" />

                        <padding>
                            <Insets bottom="8.0" left="8.0" right="8.0" />
                        </padding>
                    </VBox>

                    <VBox fx:id="filesPanel" styleClass="files-panel" VBox.vgrow="ALWAYS">

                        <HBox alignment="CENTER_LEFT" spacing="5.0">
                            <Label fx:id="lblTotalFilesText" styleClass="text-muted" text="Files in document:" />
                            <Label fx:id="lblTotalFilesInDoc" styleClass="h3" text="0" />
                        </HBox>

                        <StackPane VBox.vgrow="ALWAYS">

                            <ScrollPane fx:id="filesScrollPane" fitToWidth="true" styleClass="filesView">
                                <content>
                                    <TilePane fx:id="filesTilePane" hgap="16.0" prefColumns="3" vgap="16.0">
                                        <padding>
                                            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                        </padding>
                                    </TilePane>
                                </content>
                            </ScrollPane>

                            <BorderPane fx:id="topOverview" styleClass="preview" visible="false" StackPane.alignment="CENTER">

                                <top>
                                    <HBox alignment="CENTER_LEFT" prefHeight="40.0" spacing="8.0" BorderPane.alignment="CENTER">
                                        <Label styleClass="panel-title" text="Preview" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Button mnemonicParsing="false" onAction="#onBtnCloseOverview" styleClass="action-btn" text="Close" />
                                        <padding>
                                            <Insets left="10.0" right="10.0" top="8.0" />
                                        </padding>
                                    </HBox>
                                </top>

                                <center>
                                    <ScrollPane fx:id="previewScrollPane" fitToHeight="true" fitToWidth="true" pannable="true" styleClass="transparent-scroll" BorderPane.alignment="CENTER">
                                        <content>
                                            <BorderPane>
                                                <center>
                                                    <ImageView fx:id="previewImageView" preserveRatio="true" smooth="true" />
                                                </center>
                                            </BorderPane>
                                        </content>
                                    </ScrollPane>
                                </center>

                                <bottom>
                                    <HBox alignment="CENTER" prefHeight="50.0" spacing="10.0" BorderPane.alignment="CENTER">
                                        <Button mnemonicParsing="false" onAction="#onBtnPreviousPage" styleClass="action-btn" text="Previous" />
                                        <Button mnemonicParsing="false" onAction="#onBtnRotate" styleClass="action-btn" text="Rotate" />
                                        <Button fx:id="btnRescan" mnemonicParsing="false" onAction="#onBtnRescan" styleClass="action-btn" text="Rescan" />
                                        <Button mnemonicParsing="false" onAction="#onBtnNext" styleClass="action-btn" text="Next" />
                                        <padding>
                                            <Insets bottom="10.0" top="8.0" />
                                        </padding>
                                    </HBox>
                                </bottom>

                            </BorderPane>
                        </StackPane>

                        <padding><Insets right="8.0" /></padding>
                    </VBox>

                </items>
            </SplitPane>
        </center>

    </BorderPane>

    <ModalPane fx:id="modalPane" prefHeight="412.0" prefWidth="515.0" />

</StackPane>

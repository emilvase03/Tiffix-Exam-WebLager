<?xml version="1.0" encoding="UTF-8"?>

<?import atlantafx.base.controls.ModalPane?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane fx:id="root"
           prefHeight="574.0" prefWidth="687.0"
           stylesheets="@/css/style.css"
           xmlns="http://javafx.com/javafx/24.0.1"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="dk.easv.tiffixexamweblager.GUI.Controllers.EmployeeDashboardController">

    <BorderPane fx:id="dashboardContent"
                prefHeight="448.0" prefWidth="550.0"
                styleClass="dashboard">

        <!-- Toolbar -->
        <top>
            <HBox fx:id="topToolBar"
                  prefHeight="48.0"
                  spacing="8.0"
                  alignment="CENTER_LEFT"
                  styleClass="dashboard-toolbar"
                  BorderPane.alignment="CENTER">

                <Button fx:id="btnLogout"
                        onAction="#onLogout"
                        styleClass="action-btn">
                    <graphic><FontIcon iconLiteral="bi-box-arrow-right"/></graphic>
                </Button>

                <Button fx:id="StartScanningSession"
                        mnemonicParsing="false"
                        onAction="#onBtnStartScanningSession"
                        styleClass="action-btn"
                        text="Start scanning session"/>

                <Button fx:id="btnFetch"
                        mnemonicParsing="false"
                        onAction="#onBtnFetch"
                        styleClass="action-btn"
                        text="Fetch"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Label styleClass="text-muted" text="Current Box"/>
                <!-- lblBoxID text is set by controller; empty string avoids any encoding issue -->
                <Label fx:id="lblBoxID" styleClass="h3" text=""/>

                <Label styleClass="text-muted" text="Document Nr"/>
                <!-- lblDocumentNr text is set by controller -->
                <Label fx:id="lblDocumentNr" styleClass="h3" text="0"/>

                <padding><Insets left="8.0" right="8.0"/></padding>
            </HBox>
        </top>

        <!-- Main split area -->
        <center>
            <SplitPane dividerPositions="0.45" BorderPane.alignment="CENTER">
                <items>

                    <!-- Documents panel (left half) -->
                    <VBox fx:id="documentsPanel"
                          styleClass="documents-panel"
                          VBox.vgrow="ALWAYS">

                        <!-- Total document count header -->
                        <HBox alignment="CENTER_LEFT" spacing="5.0">
                            <Label fx:id="lblTotalDocText"
                                   styleClass="text-muted"
                                   text="Total documents in the box:"/>
                            <Label fx:id="lblTotalDocInBox"
                                   styleClass="h3"
                                   text="0"/>
                        </HBox>

                        <ScrollPane fx:id="documentsScrollPane"
                                    fitToWidth="true"
                                    styleClass="transparent-scroll"
                                    VBox.vgrow="ALWAYS">
                            <content>
                                <TilePane fx:id="documentsTilePane"
                                          hgap="14.0"
                                          vgap="14.0"
                                          prefColumns="3">
                                    <padding>
                                        <Insets bottom="8.0" left="8.0" right="8.0" top="8.0"/>
                                    </padding>
                                </TilePane>
                            </content>
                        </ScrollPane>

                        <Button mnemonicParsing="false"
                                onAction="#onBtnExport"
                                styleClass="action-btn"
                                text="Export"/>

                        <padding>
                            <Insets bottom="8.0" left="8.0" right="8.0"/>
                        </padding>
                    </VBox>

                    <!-- Files panel (right half) -->
                    <VBox fx:id="filesPanel"
                          styleClass="files-panel"
                          VBox.vgrow="ALWAYS">

                        <!-- Total files count header -->
                        <HBox alignment="CENTER_LEFT" spacing="5.0">
                            <Label fx:id="lblTotalFilesText"
                                   styleClass="text-muted"
                                   text="Files in document:"/>
                            <Label fx:id="lblTotalFilesInDoc"
                                   styleClass="h3"
                                   text="0"/>
                        </HBox>

                        <StackPane VBox.vgrow="ALWAYS">

                            <!-- File tile strip -->
                            <ScrollPane fx:id="filesScrollPane"
                                        fitToWidth="true"
                                        styleClass="filesView">
                                <content>
                                    <TilePane fx:id="filesTilePane"
                                              hgap="16.0"
                                              vgap="16.0"
                                              prefColumns="3">
                                        <padding>
                                            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
                                        </padding>
                                    </TilePane>
                                </content>
                            </ScrollPane>

                            <!-- Preview overlay (sits on top of file strip) -->
                            <BorderPane fx:id="topOverview"
                                        styleClass="preview"
                                        visible="false"
                                        StackPane.alignment="CENTER">

                                <top>
                                    <HBox prefHeight="40.0"
                                          alignment="CENTER_LEFT"
                                          spacing="8.0"
                                          BorderPane.alignment="CENTER">
                                        <Label styleClass="panel-title" text="Preview"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Button mnemonicParsing="false"
                                                onAction="#onBtnCloseOverview"
                                                styleClass="action-btn"
                                                text="Close"/>
                                        <padding>
                                            <Insets left="10.0" right="10.0" top="8.0"/>
                                        </padding>
                                    </HBox>
                                </top>

                                <center>
                                    <ScrollPane fx:id="previewScrollPane"
                                                fitToHeight="true"
                                                fitToWidth="true"
                                                pannable="true"
                                                styleClass="transparent-scroll"
                                                BorderPane.alignment="CENTER">
                                        <content>
                                            <BorderPane>
                                                <center>
                                                    <ImageView fx:id="previewImageView"
                                                               preserveRatio="true"
                                                               smooth="true"/>
                                                </center>
                                            </BorderPane>
                                        </content>
                                    </ScrollPane>
                                </center>

                                <bottom>
                                    <HBox alignment="CENTER"
                                          prefHeight="50.0"
                                          spacing="10.0"
                                          BorderPane.alignment="CENTER">
                                        <Button mnemonicParsing="false"
                                                onAction="#onBtnPreviousPage"
                                                styleClass="action-btn"
                                                text="Previous"/>
                                        <Button mnemonicParsing="false"
                                                onAction="#onBtnRotate"
                                                styleClass="action-btn"
                                                text="Rotate"/>
                                        <Button fx:id="btnRescan"
                                                mnemonicParsing="false"
                                                onAction="#onBtnRescan"
                                                styleClass="action-btn"
                                                text="Rescan"/>
                                        <Button mnemonicParsing="false"
                                                onAction="#onBtnNext"
                                                styleClass="action-btn"
                                                text="Next"/>
                                        <padding>
                                            <Insets bottom="10.0" top="8.0"/>
                                        </padding>
                                    </HBox>
                                </bottom>

                            </BorderPane>
                        </StackPane>

                        <padding><Insets right="8.0"/></padding>
                    </VBox>

                </items>
            </SplitPane>
        </center>

    </BorderPane>

    <ModalPane fx:id="modalPane" prefHeight="412.0" prefWidth="515.0"/>

</StackPane>

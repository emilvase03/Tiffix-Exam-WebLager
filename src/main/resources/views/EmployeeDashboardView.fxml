<?xml version="1.0" encoding="UTF-8"?>

<?import atlantafx.base.controls.ModalPane?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TreeView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane fx:id="root" prefHeight="600.0" prefWidth="900.0"
           stylesheets="@/css/style.css"
           xmlns="http://javafx.com/javafx/24.0.1"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="dk.easv.tiffixexamweblager.GUI.Controllers.EmployeeDashboardController">

    <BorderPane fx:id="dashboardContent" styleClass="dashboard">

        <top>
            <VBox BorderPane.alignment="CENTER">
                <HBox prefHeight="26.0">
                    <ImageView fitHeight="37.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
                        <image><Image url="@../img/Tiffix.png"/></image>
                    </ImageView>
                    <Region HBox.hgrow="ALWAYS"/>
                    <fx:include source="../components/ThemeToggleButton.fxml"/>
                    <padding><Insets top="4.0" right="8.0"/></padding>
                </HBox>

                <HBox fx:id="topToolBar" alignment="CENTER_LEFT" prefHeight="48.0"
                      spacing="8.0" styleClass="dashboard-toolbar">
                    <Button fx:id="btnLogout" onAction="#onLogout" styleClass="action-btn">
                        <graphic><FontIcon iconLiteral="bi-box-arrow-right"/></graphic>
                    </Button>
                    <Button mnemonicParsing="false" onAction="#onBtnStartScanningSession"
                            styleClass="action-btn" text="Start scanning session"/>
                    <Button fx:id="btnFetch" mnemonicParsing="false" onAction="#onBtnFetch"
                            styleClass="action-btn" text="Fetch"/>
                    <Label fx:id="lblInfo" onMouseEntered="#onMouseEnter" onMouseExited="#onMouseExit" styleClass="sidebar-btn">
                        <graphic>
                            <FontIcon iconLiteral="bi-question-square" />
                        </graphic>
                    </Label>
                    <Region HBox.hgrow="ALWAYS"/>
                    <HBox alignment="CENTER" spacing="6">
                        <Label styleClass="h3" text="Box"/>
                        <Label fx:id="lblBoxID" styleClass="h3" text=""/>
                        <Label styleClass="h3" text="|"/>
                        <Label fx:id="lblDocumentNr" styleClass="h3" text=""/>
                    </HBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <HBox alignment="CENTER" spacing="6">
                        <Label styleClass="h3" text="Files in box"/>
                        <Label fx:id="lblTotalFilesInBox" styleClass="h3"/>
                    </HBox>
                    <padding><Insets left="8.0" right="8.0"/></padding>
                </HBox>
            </VBox>
        </top>

        <center>
            <SplitPane dividerPositions="0.30" BorderPane.alignment="CENTER">
                <items>

                    <VBox fx:id="documentsPanel" styleClass="documents-panel" VBox.vgrow="ALWAYS">

                        <HBox alignment="CENTER_LEFT" spacing="5.0">
                            <Label fx:id="lblTotalDocText"
                                   styleClass="text-muted" text="Total documents in box:"
                                   visible="false" managed="false"/>
                            <Label fx:id="lblTotalDocInBox"
                                   styleClass="h3" text="0"
                                   visible="false" managed="false"/>
                        </HBox>

                        <TreeView fx:id="treeView"
                                  styleClass="nav-tree"
                                  VBox.vgrow="ALWAYS"/>

                        <Button mnemonicParsing="false" onAction="#onBtnExport"
                                styleClass="action-btn" text="Export"/>
                        <padding><Insets bottom="8.0" left="8.0" right="8.0" top="4.0"/></padding>
                    </VBox>

                    <VBox fx:id="filesPanel" styleClass="files-panel" VBox.vgrow="ALWAYS">

                        <HBox alignment="CENTER_LEFT" spacing="5.0">
                            <Label fx:id="lblTotalFilesText"
                                   styleClass="text-muted" text="Files in document:"
                                   visible="false" managed="false"/>
                            <Label fx:id="lblTotalFilesInDoc"
                                   styleClass="h3" text="0"
                                   visible="false" managed="false"/>
                        </HBox>

                        <StackPane VBox.vgrow="ALWAYS">
                            <ScrollPane fx:id="filesScrollPane" fitToWidth="true"
                                        styleClass="filesView">
                                <content>
                                    <TilePane fx:id="filesTilePane" hgap="16.0"
                                              prefColumns="3" vgap="16.0">
                                        <padding>
                                            <Insets bottom="10.0" left="10.0"
                                                    right="10.0" top="10.0"/>
                                        </padding>
                                    </TilePane>
                                </content>
                            </ScrollPane>

                            <BorderPane fx:id="topOverview" styleClass="preview"
                                        visible="false" StackPane.alignment="CENTER">
                                <top>
                                    <HBox alignment="CENTER_LEFT" prefHeight="40.0"
                                          spacing="8.0" BorderPane.alignment="CENTER">
                                        <Label styleClass="panel-title" text="Preview"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Button mnemonicParsing="false"
                                                onAction="#onBtnCloseOverview"
                                                styleClass="action-btn" text="Close"/>
                                        <padding><Insets left="10.0" right="10.0" top="8.0"/></padding>
                                    </HBox>
                                </top>
                                <center>
                                    <ScrollPane fx:id="previewScrollPane" fitToHeight="true"
                                                fitToWidth="true" pannable="true"
                                                styleClass="transparent-scroll"
                                                BorderPane.alignment="CENTER">
                                        <content>
                                            <BorderPane>
                                                <center>
                                                    <ImageView fx:id="previewImageView"
                                                               preserveRatio="true" smooth="true"/>
                                                </center>
                                            </BorderPane>
                                        </content>
                                    </ScrollPane>
                                </center>
                                <bottom>
                                    <HBox alignment="CENTER" prefHeight="50.0" spacing="10.0"
                                          BorderPane.alignment="CENTER">
                                        <Button mnemonicParsing="false"
                                                onAction="#onBtnPreviousPage"
                                                styleClass="action-btn" text="Previous"/>
                                        <Button mnemonicParsing="false" onAction="#onBtnRotate"
                                                styleClass="action-btn" text="Rotate"/>
                                        <Button fx:id="btnRescan" mnemonicParsing="false"
                                                onAction="#onBtnRescan"
                                                styleClass="action-btn" text="Rescan"/>
                                        <Button mnemonicParsing="false" onAction="#onBtnNext"
                                                styleClass="action-btn" text="Next"/>
                                        <padding><Insets bottom="10.0" top="8.0"/></padding>
                                    </HBox>
                                </bottom>
                            </BorderPane>
                        </StackPane>

                        <padding><Insets right="8.0"/></padding>
                    </VBox>

                </items>
            </SplitPane>
        </center>

    </BorderPane>

    <VBox fx:id="shortcutCardOverlay" alignment="CENTER" visible="false" mouseTransparent="true">
        <fx:include fx:id="shortcutOverlay" source="../components/ShortcutCard.fxml" />
    </VBox>

    <ModalPane fx:id="modalPane" prefHeight="412.0" prefWidth="515.0"/>

</StackPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane fx:id="root" prefHeight="600" prefWidth="900" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dk.easv.tiffixexamweblager.GUI.Controllers.AdminDashboardController">

    <VBox>

        <HBox alignment="CENTER_LEFT" spacing="16" styleClass="top-bar">

            <Button mnemonicParsing="false" onAction="#onBtnOpenSideBar" styleClass="hamburger-btn" text="☰" />
         <VBox alignment="CENTER">
            <children>
                  <Label fx:id="lblInfo" onMouseEntered="#onMouseEnter" onMouseExited="#onMouseExit" styleClass="sidebar-btn">
                      <graphic>
                          <FontIcon iconLiteral="bi-question-square" />
                      </graphic>
                  </Label>
               <Label alignment="CENTER" prefHeight="17.0" prefWidth="36.0" text="Ctrl+H" textAlignment="CENTER" VBox.vgrow="ALWAYS">
                  <font>
                     <Font size="10.0" />
                  </font>
               </Label>
            </children>
            <padding>
               <Insets top="2.0" />
            </padding>
         </VBox>
         <ImageView fitHeight="45.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
            <image>
               <Image url="@../img/Tiffix.png" />
            </image>
         </ImageView>

            <Label styleClass="top-bar-title" text="Admin Dashboard" />

            <Region HBox.hgrow="ALWAYS" />

            <HBox alignment="CENTER_LEFT" spacing="8">
                <FontIcon iconLiteral="bi-person-circle" />
                <Label styleClass="top-bar-user" text="Welcome, Admin" />
                <fx:include source="../components/ThemeToggleButton.fxml" />
            </HBox>

        </HBox>

        <StackPane fx:id="contentArea" styleClass="content-area" VBox.vgrow="ALWAYS" />

    </VBox>

    <VBox fx:id="shortcutCardOverlay" alignment="CENTER" mouseTransparent="true" visible="false">
        <fx:include fx:id="shortcutOverlay" source="../components/ShortcutCard.fxml" />
    </VBox>

</StackPane>

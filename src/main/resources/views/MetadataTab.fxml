<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dk.easv.tiffixexamweblager.GUI.Controllers.MetadataTabController">
    <children>
        <VBox alignment="TOP_CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="-Infinity" minWidth="-Infinity" prefHeight="505.0" prefWidth="772.0" spacing="5.0">
            <children>

                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                    <children>
                        <HBox alignment="CENTER_LEFT" prefHeight="32.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Metadata">
                                    <font>
                                        <Font name="Roboto Regular" size="24.0" />
                                    </font>
                                </Label>
                            </children>
                        </HBox>
                    </children>
                    <VBox.margin>
                        <Insets top="10.0" />
                    </VBox.margin>
                </HBox>

                <TableView fx:id="tblMetadata" prefHeight="505.0" prefWidth="752.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colBoxTitle" prefWidth="138.0" text="Box" />
                  <TableColumn fx:id="colNotes" prefWidth="308.0" text="Notes" />
                        <TableColumn fx:id="colDocumentsAmount" prefWidth="123.0" resizable="false" text="Number of docs" />
                        <TableColumn fx:id="colFilesAmount" prefWidth="99.0" resizable="false" text="Number of files" />
                  <TableColumn fx:id="colBoxActiveStatus" resizable="false" text="Box status" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

            </children>
            <padding>
                <Insets bottom="20.0" left="10.0" right="10.0" top="10.0" />
            </padding>
            <StackPane.margin>
                <Insets left="50.0" right="50.0" />
            </StackPane.margin>
        </VBox>
        <VBox fx:id="metadataCardOverlay" alignment="CENTER" managed="false" visible="false">
            <fx:include fx:id="metadataCard" source="../components/MetadataCard.fxml" />
        </VBox>
    </children>
</StackPane>
